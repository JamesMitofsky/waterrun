---
import Layout from "@/layouts/Layout.astro";
import DemoRunMap from "@/components/DemoRunMap.svelte";
import DemoRoutePlaceholder from "@/components/DemoRoutePlaceholder.astro";
import MapAssets from "@/components/MapAssets.astro";
import MapFrame from "@/components/MapFrame.astro";
import Footer from "@/components/Footer.astro";
// The handwritten headline is one flat ink over a textured alpha, so it ships
// as an alpha mask (hand-authored, see scripts/build-header-assets.ts) that
// CSS fills with `hero-ink`. Inlined: it is the LCP element and sits inside
// the `.reveal-now` entrance, and as a separate request it landed mid-animation
// and popped in.
// Dimensions come from the generated module rather than an image import: a
// bare import of the WebP makes the image pipeline emit a copy nobody requests.
import heroMask from "@/assets/hero-handwriting-mask.webp?inline";
import { HERO_MASK_SIZE } from "@/assets/hero-handwriting-mask.generated";

export const prerender = true;

// Wave-cut silhouette for the manifesto plate. The top and bottom edges roll as
// smooth waves at uneven intervals; the left/right sides stay straight for the
// full-bleed section. Wave x offsets are fractions of the width (0–1) so the
// silhouette stays responsive; cubic beziers give true curves, which polygon()
// cannot. Offsets are hardcoded — not random.
// The edges are rendered as their own fixed-height bands rather than clipped out
// of the plate — see `bandPath` below for why.
// The bands and the raising drop-shadow live on separate elements: the shadow
// has to trace all three pieces of the plate as one silhouette.
const tornShadow =
  "filter: drop-shadow(0 2px 3px rgba(60, 48, 24, 0.32)) drop-shadow(0 9px 18px rgba(60, 48, 24, 0.24));";

// Smooth wave through a list of points. Each segment is a cubic whose control
// points sit at the horizontal midpoint, so consecutive crests/troughs blend
// into a continuous curve rather than kinking at each point.
const r = (n: number) => Math.round(n * 10000) / 10000;
const waveThrough = (pts: { x: number; y: number }[]) =>
  pts.slice(1).reduce(
    (d, p, i) => {
      const prev = pts[i];
      const mx = r(prev.x + (p.x - prev.x) / 2);
      return `${d} C ${mx} ${r(prev.y)}, ${mx} ${r(p.y)}, ${r(p.x)} ${r(p.y)}`;
    },
    `M ${r(pts[0].x)} ${r(pts[0].y)}`,
  );

// Uneven wave-crest positions along the width; y alternates crest (0) / trough.
const topWave = [
  { x: 0, y: 0.02 },
  { x: 0.09, y: 0 },
  { x: 0.15, y: 0.03 },
  { x: 0.27, y: 0.005 },
  { x: 0.34, y: 0.028 },
  { x: 0.48, y: 0 },
  { x: 0.55, y: 0.025 },
  { x: 0.68, y: 0.004 },
  { x: 0.76, y: 0.03 },
  { x: 0.88, y: 0.008 },
  { x: 1, y: 0.02 },
];
const bottomWave = [
  { x: 1, y: 0.98 },
  { x: 0.88, y: 1 },
  { x: 0.76, y: 0.972 },
  { x: 0.68, y: 0.996 },
  { x: 0.55, y: 0.975 },
  { x: 0.48, y: 1 },
  { x: 0.34, y: 0.978 },
  { x: 0.27, y: 0.996 },
  { x: 0.15, y: 0.97 },
  { x: 0.09, y: 0.995 },
  { x: 0, y: 0.98 },
];
// Simpler wave for mobile — fewer crests so narrow screens don't look too busy.
const mobileTopWave = [
  { x: 0, y: 0.022 },
  { x: 0.25, y: 0 },
  { x: 0.5, y: 0.03 },
  { x: 0.78, y: 0.005 },
  { x: 1, y: 0.02 },
];
const mobileBottomWave = [
  { x: 1, y: 0.978 },
  { x: 0.72, y: 1 },
  { x: 0.48, y: 0.972 },
  { x: 0.22, y: 0.997 },
  { x: 0, y: 0.98 },
];

// Each wave edge is its own band: a full-width SVG of fixed CSS height that
// hangs off the top or bottom of the blue block and paints the crests.
//
// The plate used to be `clip-path: url(#…)` with `clipPathUnits="objectBound
// ingBox"`, which made crest depth a *fraction of the section's height*. That
// height is set by the copy inside, so anything that reflows the copy after
// first paint — a body web font landing (they are `font-display: swap`), a
// wording edit — rescaled the wave and moved the edge, and it visibly resettled
// once loaded. A band decouples the two axes: x stays in fractions of the width
// (the band stretches via `preserveAspectRatio="none"`, so the crests stay put
// at any viewport width), while y is pinned to the band's own px height. The
// silhouette is then identical whatever the section's height turns out to be.
const BAND_W = 1000; // band viewBox width; stretched across the plate
const BAND_H = 100; // band viewBox height; CSS gives the band its real px height
const bandPath = (pts: { x: number; y: number }[], edge: "top" | "bottom") => {
  const ys = pts.map((p) => p.y);
  const min = Math.min(...ys);
  const span = Math.max(...ys) - min || 1;
  // Trace left-to-right whichever way the wave was written, and normalise y so
  // the wave uses the full band: its deepest point reaches the far side.
  const ordered = pts[0].x <= pts[pts.length - 1].x ? pts : [...pts].reverse();
  const curve = waveThrough(
    ordered.map((p) => ({ x: r(p.x * BAND_W), y: r(((p.y - min) / span) * BAND_H) })),
  );
  // Top band is plate colour below the curve (crests reach up out of the
  // plate); bottom band is plate colour above it.
  return edge === "top"
    ? `${curve} L ${BAND_W} ${BAND_H} L 0 ${BAND_H} Z`
    : `${curve} L ${BAND_W} 0 L 0 0 Z`;
};
const topBand = bandPath(topWave, "top");
const bottomBand = bandPath(bottomWave, "bottom");
const mobileTopBand = bandPath(mobileTopWave, "top");
const mobileBottomBand = bandPath(mobileBottomWave, "bottom");
---

{/* The header floats over the hero map rather than sitting on a white bar above it. */}
<Layout overlayHeader>
  <MapAssets slot="head" />
  <main class="bg-surface font-body relative text-base">
    {
      /* HERO — the demo map *is* the section. It fills the first screen edge to
        edge and runs on under the manifesto plate's wave; the headline and
        subtitle are painted over it. */
    }
    <section class="hero relative flex overflow-hidden">
      {
        /* Interactive demo of the run + edit flow. Deliberately not a `.reveal`
          block: that starts at opacity 0 and waits for the scroll observer,
          which would hide the map's own loading frame for exactly the window
          the frame exists to fill. Its dissolve is the entrance.

          The map reaches the section's bottom edge, and the plate below is
          pulled up over that edge (`-my-6` on its wrapper) with its wave band
          hanging higher still — so the map's last strip is seen through the
          crests, and the plate's drop-shadow falls on the map. The attribution
          is lifted by the same amount so it never goes under with it.

          `.hero-map-box` also tells the map which part of it is in the clear
          (see the style block), so a tapped marker is centred in the map the
          visitor can see rather than in the middle of the section, half of
          which is under the wash and the copy. */
      }
      <div class="hero-map-box absolute inset-0">
        {
          /* The loading state is `MapFrame`'s, not the island's: a picture of
            this exact opening view, server-rendered and inline, so it is up
            in the first paint rather than after the island hydrates. */
        }
        <MapFrame frame="demo-run" radius="0" class="hero-map h-full w-full">
          <DemoRoutePlaceholder slot="placeholder" />
          <DemoRunMap client:only="svelte" />
        </MapFrame>
      </div>

      {
        /* Page white washed over the map where the copy sits — the right half
          on desktop, the top on mobile — fading to nothing over the route. The
          map's opening view is shifted to match, so the route sits in the clear
          half rather than under the veil (see `frames.ts`). No pointer events:
          the map stays live underneath. */
      }
      <div class="hero-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>

      {
        /* Mobile: title -> subtitle at the top, map below in the clear. Desktop:
          copy in the right half, vertically centred, map showing in the left.
          The column passes pointer events through to the map; only the copy
          block itself takes them, so its text stays selectable. */
      }
      <div
        class="pointer-events-none relative mx-auto flex w-full max-w-6xl flex-col px-5 pt-28 pb-28 md:justify-center md:pt-20 md:pb-32"
      >
        <div class="pointer-events-auto flex flex-col items-start gap-2 md:ml-auto md:w-1/2">
          {
            /* The title is hand-lettered ink, drawn as a mask on the `<h1>` itself
              (see `.hero-mark` below), so the page still has a real heading;
              `role="img"` + `aria-label` carry its words for readers and search
              engines the way an `<img alt>` did. */
          }
          <h1
            role="img"
            aria-label="An accurate map of nearby drinking fountains made by your friendly neighborhood runners"
            class="hero-mark reveal-now bg-hero-ink w-full max-w-xl md:max-w-none"
            style={`--reveal-delay: 0.1s; --hero-mask: url(${heroMask}); aspect-ratio: ${HERO_MASK_SIZE.width} / ${HERO_MASK_SIZE.height}`}
          >
          </h1>

          <div class="reveal-now flex flex-col items-start gap-7" style="--reveal-delay: 0.16s">
            <!-- Narrow screens set this smaller but heavier: it sits over live map
              now, where a light 1.2rem line thinned out against the tiles. -->
            <p
              class="text-muted mt-2 max-w-md text-[1.05rem] leading-snug font-normal md:text-[1.2rem] md:leading-relaxed md:font-light"
            >
              Is it civic service? Gamified running? A way to get more kudos on Strava? Exactly.
            </p>
          </div>
        </div>
      </div>
    </section>

    {
      /* MANIFESTO SPLIT — a raised, hand-torn surface strip over the page.
        Wrapper casts the shadow; the plate is a plain blue block with a wave
        band hanging off each edge. `drop-shadow` reads the alpha of the whole
        subtree, so one filter on the wrapper traces all three as one silhouette
        — which is also why it can't live on the plate itself. */
    }
    <div class="relative z-10 -my-6" style={tornShadow}>
      {
        /* `currentColor` on the bands is the plate's own blue, so the edges and
          the block can never drift apart. */
      }
      <div class="manifesto-plate text-blue">
        <svg
          class="manifesto-edge manifesto-edge--top edge-desktop"
          viewBox={`0 0 ${BAND_W} ${BAND_H}`}
          preserveAspectRatio="none"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={topBand}></path>
        </svg>
        <svg
          class="manifesto-edge manifesto-edge--top edge-mobile"
          viewBox={`0 0 ${BAND_W} ${BAND_H}`}
          preserveAspectRatio="none"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={mobileTopBand}></path>
        </svg>
        <section class="bg-blue">
          <div class="reveal manifesto-body mx-auto max-w-3xl px-5">
            <h2
              class="font-hero text-light text-[clamp(2.5rem,5vw,3.4rem)] leading-[1.05] tracking-tight"
            >
              What's the Deal?
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-white/85">
              Water Run is a runner-sourced map of public drinking fountains.
            </p>
            <p class="mt-6 text-lg leading-relaxed text-white/85">
              It documents fountain location, working status, seasonality, type (eg. bottle-filler,
              bubbler, dog bowl), and more.
            </p>

            <p class="mt-4 text-lg leading-relaxed text-white/85">
              Contributing to this map has both immediate and long-term benefits:
            </p>
            <ul class="mt-4 list-disc space-y-1 pl-6 text-lg leading-relaxed text-white/85">
              <li>
                <span class="font-bold">Immediately</span>: reliable access to {" "}
                <i>working</i> fountains increases.
              </li>
              <li>
                <span class="font-bold">Long-term</span>: repair requests are automatically
                submitted to 311.
              </li>
            </ul>
          </div>
        </section>
        <svg
          class="manifesto-edge manifesto-edge--bottom edge-desktop"
          viewBox={`0 0 ${BAND_W} ${BAND_H}`}
          preserveAspectRatio="none"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={bottomBand}></path>
        </svg>
        <svg
          class="manifesto-edge manifesto-edge--bottom edge-mobile"
          viewBox={`0 0 ${BAND_W} ${BAND_H}`}
          preserveAspectRatio="none"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={mobileBottomBand}></path>
        </svg>
      </div>
    </div>

    {/* THE SOLUTION */}
    <section>
      <div class="reveal mx-auto max-w-3xl px-5 pt-20 pb-2 md:pt-28">
        <h2
          class="font-hero text-hero text-[clamp(2.5rem,5vw,3.4rem)] leading-[1.05] tracking-tight"
        >
          Powered by Runners
        </h2>
        <p class="text-muted mt-6 text-lg leading-relaxed">
          This map is made by runners, for... everyone! By routing runners past fountains that
          haven't been checked in a while, we regularly canvas where drinking fountains are most
          densely placed.
        </p>
        <p class="text-muted mt-6 text-lg leading-relaxed">
          But why runners? Runners are able to quickly test if a fountain works and move on. Compare
          this with cycling, for example, which lends itself to longer stretches in the saddle. Or
          walking, which tends not to cover much distance at one time. Each end of this
          pedestrian-spectrum has something to offer, but we're currently optimized for the biggest
          impact on the places where fountains are most dense: cities.
        </p>
      </div>
    </section>

    {/* FOOTER */}
    <Footer />
  </main>

  {
    /* Scroll-reveal (was framer-motion fadeUp) for the blocks below the hero:
      each `.reveal` block is revealed once, as it crosses into view. The
      positive bottom rootMargin extends the trigger zone below the viewport so
      blocks start revealing while still under the fold, and `will-change` is
      dropped once the transition ends, since a GPU layer is expensive to hold.

      A classic inline script, not a bundled module: modules wait for the whole
      document and every module before them, which is how the hero used to sit
      invisible behind the map's script chain. So it is plain JS (`is:inline`
      is not compiled), wrapped in a block to keep its bindings out of the
      global scope, and explained out here rather than inside, because inline
      script ships byte for byte. */
  }
  <script is:inline>
    {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target;
            el.classList.add("in-view");
            obs.unobserve(el);
            el.addEventListener(
              "transitionend",
              () => {
                el.style.willChange = "auto";
              },
              { once: true },
            );
          }
        },
        { rootMargin: "0px 0px 20% 0px", threshold: 0 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    }
  </script>
  <style>
    /* Handwritten headline: a flat fill (`bg-hero-ink`) shown through the ink's
     alpha. The mask stretches to the box; `aspect-ratio` inline keeps the box
     the image's shape so nothing distorts. `-webkit-` first, standard last: the
     minifier keeps the later of a prefix pair if the cssTarget floor is ever
     dropped, and Safari < 15.4 needs the prefix. */
    .hero-mark {
      -webkit-mask-image: var(--hero-mask);
      mask-image: var(--hero-mask);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      /* No `mask-mode`: the file carries the ink in its alpha channel, which is
       what every engine masks with by default. It used to be a luminance mask
       (white ink on black, `mask-mode: luminance`), and that is what iOS
       rendered as a solid blue rectangle — WebKit drops the luminance flag
       whenever the mask's pattern tile is bigger than 512 x 512 device pixels,
       which a full-width headline on a 3x phone always is (webkit.org/b/282530).
       The desktop limit is 2048 x 2048, so it only ever broke on the phone.
       Keep any future re-export alpha; see scripts/build-header-assets.ts,
       which fails the build if the alpha channel goes missing. */
    }
    /* The first screen, less the strip the plate's wave takes back from the
     bottom — so the crests are in view at the fold rather than just under it.
     The header floats over this section (`overlayHeader`), so the section
     starts at the top of the document and the copy pads itself clear of the
     bar. Floored so a short window still has room for the copy and the route;
     capped so a tall one does not become a wall of map. The frame spec in
     `frames.ts` is measured at this height; change one, re-check the other. */
    .hero {
      min-height: clamp(36rem, 100svh - 2.5rem, 52rem);
      /* How far the plate reaches up over the map: its wrapper's `-my-6` plus
       the wave band hanging above its top edge (`--edge`, below). */
      --hero-under-plate: calc(1.5rem + var(--edge));
      /* The wash's stops. Narrow screens: it fades out downward and is gone at
       `--hero-wash-end`. Wide: it fades in rightward from `--hero-wash-start`
       and is (all but) full from `--hero-wash-full`. Read by both the wash
       gradient and the map's visible-area insets on `.hero-map-box`, so the
       map's idea of "in the clear" cannot drift from the wash. */
      --hero-wash-end: 46%;
      --hero-wash-start: 40%;
      --hero-wash-full: 58%;
      /* The header floating over the section (`overlayHeader`): logo `h-12`
       plus `py-4`. Its strip is the map's on wide screens, where the wash does
       not cover it; the copy's `md:pt-20` clears the same bar. */
      --hero-bar: 5rem;
    }
    .hero-wash {
      /* Narrow screens never reach either extreme: the top stays short of pure
       surface so the map reads through the copy, and the fade lands on a thin
       haze rather than nothing, which keeps the lower map from snapping to full
       contrast at `--hero-wash-end`. The last stop carries on to the bottom. */
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 80%, transparent) 0%,
        color-mix(in srgb, var(--color-surface) 60%, transparent) 24%,
        color-mix(in srgb, var(--color-surface) 25%, transparent) var(--hero-wash-end)
      );
    }
    /* The map's visible area (`--map-view-inset-*`, read by `MapView`) and
     the corner its controls are lifted to. Narrow: the wash and copy cover the
     top — right down to where the wash ends, since the copy sits over the
     fade — and the plate the bottom. Wide: the copy takes the right, but only
     from the middle of the fade, where the wash passes half strength; the map
     is still mostly seen through the lighter half, and centring a marker in
     the fully clear strip alone pushed it hard against the left edge. The
     header bar takes the top. */
    .hero-map-box {
      --map-ctrl-inset-bottom: var(--hero-under-plate);
      --map-view-inset-top: var(--hero-wash-end);
      --map-view-inset-bottom: var(--hero-under-plate);
    }
    @media (min-width: 768px) {
      .hero-wash {
        background: linear-gradient(
          90deg,
          transparent var(--hero-wash-start),
          color-mix(in srgb, var(--color-surface) 82%, transparent) var(--hero-wash-full),
          color-mix(in srgb, var(--color-surface) 90%, transparent) 100%
        );
      }
      .hero-map-box {
        --map-view-inset-top: var(--hero-bar);
        --map-view-inset-right: calc(100% - (var(--hero-wash-start) + var(--hero-wash-full)) / 2);
      }
    }
    /* Crest depth, in px. A px value is the whole point of the bands: it is what
     the old objectBoundingBox clip could not express (see `bandPath`). Set to
     roughly the depth the fractional wave used to resolve to at this section's
     usual height, so the plate looks the same — it just stops moving. Declared
     on `main` so the hero above the plate can read it too. */
    main {
      --edge: 14px;
    }
    .manifesto-plate {
      position: relative;
    }
    .manifesto-edge {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      /* One extra px, overlapped into the plate below, so no hairline of page
       shows through the seam on fractional device pixel ratios. */
      height: calc(var(--edge) + 1px);
    }
    .manifesto-edge--top {
      bottom: calc(100% - 1px);
    }
    .manifesto-edge--bottom {
      top: calc(100% - 1px);
    }
    /* The bands add their height outside the block, where the clip used to take
     it from inside. Pull the copy in by the same amount and the plate keeps the
     breathing room it had. */
    .manifesto-body {
      padding-block: calc(5rem - var(--edge));
    }
    @media (min-width: 768px) {
      .manifesto-body {
        padding-block: calc(7rem - var(--edge));
      }
    }
    /* Show the band matching the wave the plate uses at this breakpoint. */
    .edge-mobile {
      display: none;
    }
    @media (max-width: 767px) {
      .edge-desktop {
        display: none;
      }
      .edge-mobile {
        display: block;
      }
    }
  </style>
</Layout>
