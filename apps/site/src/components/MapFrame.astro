---
import { MAP_PLACEHOLDERS } from "@/lib/basemap/placeholders.generated";
import {
  BASEMAP_BACKGROUND,
  MAP_FRAMES,
  MAP_REVEAL_MS,
  type MapFrameId,
} from "@/lib/basemap/frames";

/**
 * The box every MapLibre map on the site renders inside: a server-rendered
 * loading frame that holds a picture of the map's opening view until the real
 * map reports it has drawn that view, then dissolves off it.
 *
 * How the wait looks is the frame's `loading` (see `frames.ts`): frosted glass
 * and a spinner over a picture that is only the ground, or — for a frame whose
 * placeholder is the map itself, already in motion — the picture as it is,
 * with nothing to say that anything is loading, because to the visitor
 * nothing is.
 *
 * The frame owns the sizing, not the island, so the loading state and the map
 * occupy exactly the same rectangle and nothing reflows when one replaces the
 * other. Callers give it a width; its height comes from the frame spec.
 *
 * What makes this worth building rather than leaving a spinner on a blank
 * panel: the maps are
 * `client:only` islands, so *nothing* of them exists in the served HTML. Until
 * the island chunk downloads, hydrates, pulls ~1MB of MapLibre and paints a
 * tile, the frame is dead space — and none of that can be raced by anything
 * that has to be fetched. A base64 image inside the HTML is subject to none of
 * it: it is up in the first paint, and the live map slides in underneath.
 *
 * Everything here is static markup plus CSS. There is no JS in the loading path
 * at all — the script below only runs to take the overlay *away*.
 */

interface Props {
  /** Which map, in which position — see `lib/basemap/frames.ts`. */
  frame: MapFrameId;
  /**
   * Corner radius of the card this sits in, as a CSS length.
   *
   * Stated rather than inherited, because inheriting it does not survive the
   * trip: Astro renders the island inside an `<astro-island>` element, and
   * `border-radius: inherit` resolves against *that*, which has none. Defaults
   * to `rounded-xl`, which is what every card holding a map on this site uses.
   */
  radius?: string;
  class?: string;
}

const { frame, radius = "0.75rem", class: className = "" } = Astro.props;

// Mobile-first, matching how `<picture>` resolves: the first `<source>` whose
// media matches wins, and the bare `<img>` is the fallback. Each map picks its
// opening zoom off the same breakpoint, so this is the browser resolving that
// choice in the HTML parser — before any of the island's JS exists to make it.
const shots = MAP_PLACEHOLDERS[frame];
const sources = shots.filter((s) => s.media !== null);
const fallback = shots.find((s) => s.media === null) ?? shots[shots.length - 1];

// The picture is drawn at its variant's own CSS size, centred, and the box
// crops it — never scaled to fit. That is what keeps the picture and the live
// map showing the same ground: a map at a fixed zoom shows a fixed amount of
// ground per pixel and lets the box crop it, so the picture must do exactly the
// same. Scaled to the box instead, the two disagreed by whatever the box's size
// differed from the picture's, and a route drawn off-centre landed off by that
// factor times its offset. The variant's size is also emitted as the frame's
// `aspect-ratio`, for a caller that gives it only a width.
//
// Sizes come from `frames.ts` rather than from callers on purpose: a size in
// the caller and a reference size in the spec are two numbers free to drift
// apart, and nothing catches it when they do.
const variants = MAP_FRAMES[frame].variants;
const base = variants.find((v) => v.media === null) ?? variants[variants.length - 1];
const ratio = (v: (typeof variants)[number]) => `${v.frame.width}/${v.frame.height}`;
const selector = `[data-map-frame="${frame}"]`;
// Base rule first, `max-width` queries after it, so the narrow variants win at
// the widths they name — the same order `<picture>` resolves the sources in.
const aspectCss = [
  `${selector}{aspect-ratio:${ratio(base)}}`,
  ...variants
    .filter((v) => v.media !== null)
    .map((v) => `@media ${v.media}{${selector}{aspect-ratio:${ratio(v)}}}`),
].join("");
// The spinner sits over the map's subject, not necessarily the frame's centre:
// a frame whose opening view is shifted (see `MapFrameVariant.subject`) has
// its subject — and the clear space around it — off to one side, and the
// page may well have put copy where the centre is. Same base-then-media order
// as the aspect rules, for the same reason.
const ordered = [base, ...variants.filter((v) => v.media !== null)];
const perVariant = (rule: (v: (typeof variants)[number]) => string | null) =>
  ordered
    .map((v) => {
      const r = rule(v);
      return r === null ? "" : v.media === null ? r : `@media ${v.media}{${r}}`;
    })
    .join("");
const sizeCss = perVariant(
  (v) =>
    `${selector} .map-frame__shot,${selector} .map-frame__content` +
    `{width:${v.frame.width}px;height:${v.frame.height}px}`,
);
const { loading } = MAP_FRAMES[frame];
const frosted = loading.kind === "frosted" ? loading : null;
const spinnerCss = frosted
  ? perVariant((v) =>
      v.subject
        ? `${selector} .map-frame__spinner{translate:${v.subject.x}px ${v.subject.y}px}`
        : null,
    )
  : "";
const frameCss = aspectCss + sizeCss + spinnerCss;
---

{
  /* Global on purpose: the selector is the frame id, so it can only ever match
    frames of this kind, and Astro dedupes the identical block emitted by a
    second map of the same kind on the page. */
}
<style is:global set:html={frameCss}></style>

{
  /* The basemap's paper colour reaches the stylesheet as one custom property on
    the root rather than through `define:vars`, which stamps the declaration onto
    every element the component renders. */
}
<div
  class:list={["map-frame", className]}
  style={`--basemap-background: ${BASEMAP_BACKGROUND}; --map-frame-radius: ${radius};${frosted ? ` --map-frame-blur: ${frosted.blur}px;` : ""} --map-reveal-ms: ${MAP_REVEAL_MS}ms`}
  data-map-frame={frame}
>
  {
    /* The overlay never changes its own opacity — every layer inside fades
      separately. That is not a style preference: it keeps the container from
      becoming its own compositing/backdrop root mid-fade, which is what made a
      group fade cut the frosted layer off from what it sits over. */
  }
  <div class="map-frame__overlay" data-map-overlay>
    {
      /* The frame's own paper, behind the thumbnail. Without it the first paint
        is the page showing through wherever the image has not decoded yet — and
        it is also the layer whose `transitionend` retires the overlay, since it
        is the one layer that is always present. */
    }
    <div class="map-frame__paper" data-reveal-backdrop aria-hidden="true"></div>

    <picture>
      {sources.map((s) => <source media={s.media!} srcset={s.src} type="image/webp" />)}
      {
        /* Decoded on the main thread on purpose: this image exists to be in the
          first paint, and `decoding="async"` lets the browser paint a frame
          without it. It is a thumbnail of a few kilobytes, so there is nothing
          to gain by deferring it. */
      }
      <img class="map-frame__shot" src={fallback.src} alt="" aria-hidden="true" decoding="sync" />
    </picture>

    {
      /* The map's own content as it will appear at the opening view — the route
        and its stops, for a map that can position them without the engine. It
        turns the loading state from a picture of a city into the map itself,
        minus interactivity. Optional: a map whose points are only known at
        runtime simply leaves this empty. */
    }
    <div class="map-frame__content"><slot name="placeholder" /></div>

    {
      frosted && (
        <Fragment>
          {/* Frosts the frame, its route and its pins, and nothing below. This is
            the blur — it is applied *over* the map, not baked into it, so what
            is underneath stays a normal picture and a normal set of shapes, and
            the frost is a single layer whose opacity is the only thing that
            animates.

            A blur radius that winds down over the reveal is the one thing a
            compositor cannot cache: every frame would re-run a full-frame
            gaussian on the same GPU rasterising the first batch of vector
            tiles. Opacity it can animate without repainting anything, and
            fading a frosted pane out looks the same as thinning it. */}
          <div class="map-frame__glass" aria-hidden="true" />

          {/* The one moving thing on the frame, so the state reads as loading
            rather than as a map that ignores taps. Same arc-on-a-ring the site
            used before this frame existed, in the brand blue rather than white —
            it now sits on frosted paper instead of a solid blue panel. */}
          <svg class="map-frame__spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity="0.25" />
            <path
              fill="currentColor"
              opacity="0.75"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
        </Fragment>
      )
    }
  </div>

  {
    /* `z-index: 0` makes this a stacking context, which walls the island's own
      layering off from the frame's: inside a map are marker/popup bands in the
      hundreds, and without the wall those numbers would sort against the
      overlay's and paint straight through the loading state. */
  }
  <div class="map-frame__map"><slot /></div>
</div>

<style>
  /* The dissolve's length, `--map-reveal-ms`, arrives on the element's inline
     style from `MAP_REVEAL_MS` in `frames.ts` — one number, shared with the
     script below and with any map that waits for the frame to clear. The
     overlay stops taking pointer events the moment `data-map-ready` lands, so
     the map is interactive for the whole of it. */
  .map-frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* The map is a WebGL canvas on its own compositing layer, and a composited
       child is not clipped by an ancestor's rounded corner — `overflow: hidden`
       plus `border-radius` rounds the *box* and lets the canvas square off all
       four corners of the card anyway. `clip-path` is applied by the compositor
       itself, so it is the one that actually holds, and it clips every layer in
       here — canvas, glass and thumbnail alike.

       `border-radius` stays for the painted layers below (paper, glass), which
       are ordinary content and round on their own. */
    border-radius: var(--map-frame-radius);
    clip-path: inset(0 round var(--map-frame-radius));
  }

  /* Same doubled rounding as the frame, one level closer to the canvas. The
     compositor clip that matters is whichever one it actually applies to the
     island's layer, and this is the last element on the way down that is ours —
     everything below is `<astro-island>` and the map component's own markup. */
  .map-frame__map {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: var(--map-frame-radius);
    overflow: hidden;
    clip-path: inset(0 round var(--map-frame-radius));
  }

  .map-frame__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-frame[data-map-ready] .map-frame__overlay {
    pointer-events: none;
  }

  /* Every layer fades on its own rather than the overlay fading as a group.
     That is not cosmetic: an element at opacity < 1 is a backdrop root, so
     fading the container would cut the glass off from the map behind it and the
     frost would vanish in one frame instead of clearing. Nothing above ever
     leaves opacity 1; only these do. */
  .map-frame__paper,
  .map-frame__glass,
  .map-frame__shot,
  .map-frame__content,
  .map-frame__spinner {
    transition: opacity var(--map-reveal-ms) ease-in-out;
  }

  .map-frame[data-map-ready] .map-frame__paper,
  .map-frame[data-map-ready] .map-frame__glass,
  .map-frame[data-map-ready] .map-frame__shot,
  .map-frame[data-map-ready] .map-frame__content,
  .map-frame[data-map-ready] .map-frame__spinner {
    opacity: 0;
  }

  .map-frame__paper {
    position: absolute;
    inset: 0;
    background: var(--basemap-background);
  }

  /* The picture and the shapes drawn over it, at the variant's own CSS size
     (set per variant in the global block above), centred in the box and
     cropped by it. Not `inset: 0`: stretched to the box, the picture would be
     at a different scale from the map it dissolves into — see the note on
     `frame` in `frames.ts`. The box is `overflow: hidden`, so what falls
     outside is simply not drawn. */
  .map-frame__shot,
  .map-frame__content {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .map-frame__shot {
    /* The element is the exact shape of the image, so this is an identity —
       stated so a rounding difference between the two can only crop a pixel,
       never stretch one. */
    object-fit: cover;
    max-width: none;
  }

  .map-frame__glass {
    position: absolute;
    inset: 0;
    /* The blur radius, `--map-frame-blur`, arrives on the element's inline
       style from the frame's `blur` in `frames.ts` — that is the knob.

       Prefixed first, standard last, and not by convention alone: the release
       minifier reads the two as one property and keeps whichever it sees last,
       so the order here decides which of them survives the build. Standard
       last means Firefox — which has never spoken `-webkit-` — gets the frost.
       Safari has understood the unprefixed property since 18. */
    -webkit-backdrop-filter: blur(var(--map-frame-blur));
    backdrop-filter: blur(var(--map-frame-blur));
    /* A wash of the basemap's own paper over the frost, so the frame reads as
       one surface rather than as a blurred photograph. Heavier than the blur
       alone needs: a wide gaussian spreads the route's blue and the pins'
       colour across the whole frame, and the wash is what keeps that reading as
       frosted paper instead of as a stain. */
    background: color-mix(in srgb, var(--basemap-background) 48%, transparent);
  }

  .map-frame__spinner {
    position: relative;
    width: 2rem;
    height: 2rem;
    color: var(--color-blue);
    /* Named locally rather than reusing the global `spin`: Astro only rewrites
       animation names for keyframes declared in this scoped block, so borrowing
       the global one would work by coincidence of naming. */
    animation: map-frame-spin 1s linear infinite;
  }

  @keyframes map-frame-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* A spinner that does not spin reads as frozen rather than as calm, so this
     slows the rotation instead of stopping it. */
  @media (prefers-reduced-motion: reduce) {
    .map-frame__spinner {
      animation-duration: 3s;
    }
  }
</style>

<script>
  /**
   * Takes the loading overlay away once a map underneath reports it has
   * painted. Nothing here is involved in *showing* the loading state — that is
   * server-rendered HTML and CSS, and it is on screen long before this module
   * has been fetched.
   *
   * The signal is a bubbling DOM event from the map's own element, so the
   * island and this frame need share nothing but the DOM: no ids to keep in
   * sync between an Astro page and a Svelte component, and any number of maps
   * on a page each clear their own frame.
   */
  import { MAP_REVEAL_MS } from "@/lib/basemap/frames";
  /**
   * Backstop for the unmount only. The overlay normally leaves the tree when its
   * fade actually finishes — see the `transitionend` handler — and this covers
   * the cases where that event never arrives: a transition the browser never
   * started, a tab backgrounded mid-fade, `prefers-reduced-motion` collapsing
   * the duration to zero. Generous on purpose, so it never races the real event.
   */
  const UNMOUNT_FALLBACK_MS = MAP_REVEAL_MS + 400;
  /**
   * Last resort. `MapView` reports ready once its opening view is drawn, on
   * error, and on its own load timeouts, so the only way the overlay is still up past this is
   * that the island's JS never ran at all. A stale picture of a map beats a
   * loading state that never ends.
   */
  const BACKSTOP_MS = 25_000;

  for (const frame of document.querySelectorAll<HTMLElement>("[data-map-frame]")) {
    const overlay = frame.querySelector<HTMLElement>("[data-map-overlay]");
    if (!overlay) continue;

    let unmountTimer: number | undefined;
    let revealed = false;

    const backstop = window.setTimeout(() => reveal(), BACKSTOP_MS);

    function reveal() {
      if (revealed || !overlay) return;
      revealed = true;
      clearTimeout(backstop);
      frame.dataset.mapReady = "";
      unmountTimer = window.setTimeout(() => overlay.remove(), UNMOUNT_FALLBACK_MS);
    }

    // Only the paper's own fade counts. Every layer transitions over the same
    // duration and they all bubble to this element, so retiring on the first to
    // land would cut the others off mid-fade.
    overlay.addEventListener("transitionend", (event) => {
      if (event.propertyName !== "opacity") return;
      if (!(event.target as HTMLElement).hasAttribute("data-reveal-backdrop")) return;
      clearTimeout(unmountTimer);
      overlay.remove();
    });

    frame.addEventListener("rosm:map-ready", () => reveal());
  }
</script>
