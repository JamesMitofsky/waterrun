---
import { MAP_FRAMES, offsetFromCenter } from "@/lib/basemap/frames";
import { DC_FOUNTAINS, DC_ROUTE, demoStopColor } from "@/lib/demoRoute";
import { DEMO_RUN_END, demoRouteRunBy, demoRunnerAt, demoStatusesAt } from "@/lib/demoRun";
import { ROUTE_LINE, START_FLAG } from "@/lib/basemap/routeLine";
import StartFlagIcon from "@/components/icons/StartFlagIcon.svelte";

/**
 * The hero run drawn into `MapFrame`'s loading state, in the positions the
 * live map is about to put it — and in the state the live map *opens* in.
 *
 * This is the difference between a loading frame that shows a city and one
 * that shows *this map*: the same shapes, at the same places, under the frost.
 * When MapLibre finishes and the overlay dissolves, what is underneath is
 * already where the eye left it.
 *
 * What that state is depends on the visitor. The map opens on the first frame
 * of a replay (`DemoRunMap.svelte`): the whole loop faint, every stop pending,
 * the runner at the start, and nothing run yet — so that is what is drawn.
 * Under `prefers-reduced-motion` the replay is skipped and the map opens on its
 * *end* frame instead, so the same markup carries that frame too, switched in
 * by the media query: the run so far drawn solid, the reached stops in their
 * colours, the stop it ends on in the route's blue, the runner where the run
 * ends. Both come from `demoRun.ts`, the
 * same module the replay reads, so the two cannot disagree.
 *
 * None of it needs the engine. The opening view is fixed at build time, so a
 * point's offset from the frame's centre is a pure function of its
 * coordinates — see `offsetFromCenter`. This runs at build time and ships as
 * markup.
 *
 * Alignment with the thumbnail is exact rather than approximate, and that is
 * what the `viewBox`/`slice` pairing buys: the SVG's user space *is* the
 * variant's frame in CSS pixels, and `xMidYMid slice` is the same
 * centre-anchored cover-crop `object-fit: cover` applies to the image. The two
 * have the same aspect by construction, so whatever the real frame turns out to
 * be, both are scaled and cropped identically.
 */

const variants = MAP_FRAMES["demo-run"].variants;

/** Trim coordinates to a tenth of a pixel — past that it is bytes in the HTML. */
const r = (n: number) => Math.round(n * 10) / 10;

const openingStatuses = demoStatusesAt(0);
const endStatuses = demoStatusesAt(DEMO_RUN_END);
// `halted`: whether the frame shows the run come to rest at `DEMO_NEXT_STOP`,
// which is what turns that stop blue — true of the end frame only.
const colorFor = (statuses: ReturnType<typeof demoStatusesAt>, id: number, halted: boolean) =>
  demoStopColor(id, statuses[id], halted);

const shots = variants.map((variant, index) => {
  const cx = variant.frame.width / 2;
  const cy = variant.frame.height / 2;
  const at = (point: { lat: number; lon: number }) => {
    const offset = offsetFromCenter(point, variant);
    return { x: r(cx + offset.x), y: r(cy + offset.y) };
  };
  const points = (route: [number, number][]) =>
    route
      .map(([lat, lon]) => at({ lat, lon }))
      .map(({ x, y }) => `${x},${y}`)
      .join(" ");
  const runnerAt = (length: number) => {
    const [lat, lon] = demoRunnerAt(length);
    return at({ lat, lon });
  };

  return {
    id: `demo-run-${index}`,
    media: variant.media,
    viewBox: `0 0 ${variant.frame.width} ${variant.frame.height}`,
    loop: points(DC_ROUTE),
    run: points(demoRouteRunBy(DEMO_RUN_END)),
    // Where the flag's `<svg>` goes so the base of its pole is on the
    // route's first vertex (`START_FLAG.pole`).
    flag: (() => {
      const [lat, lon] = DC_ROUTE[0];
      const { x, y } = at({ lat, lon });
      return {
        x: r(x - START_FLAG.px * START_FLAG.pole.x),
        y: r(y - START_FLAG.px * START_FLAG.pole.y),
      };
    })(),
    runnerStart: runnerAt(0),
    runnerEnd: runnerAt(DEMO_RUN_END),
    stops: DC_FOUNTAINS.map((fountain, i) => ({
      ...at(fountain),
      label: String(i + 1),
      color: colorFor(openingStatuses, fountain.id, false),
      endColor: colorFor(endStatuses, fountain.id, true),
    })),
  };
});

// Which shot is shown is the same breakpoint question `<picture>` answers for
// the thumbnail, but SVG has no `<source>`, so it is answered in CSS instead.
// Generated from the variants rather than written out, so the query lives in
// `frames.ts` only — a breakpoint that drifted would show the route for one
// zoom over a picture rendered at the other.
const fallback = shots.find((s) => s.media === null) ?? shots[shots.length - 1];
const mediaCss = shots
  .filter((s) => s.media !== null)
  .map(
    (s) =>
      `@media ${s.media}{[data-map-shot="${fallback.id}"]{display:none}` +
      `[data-map-shot="${s.id}"]{display:block}}`,
  )
  .join("");
const css = `[data-map-shot]{display:none}[data-map-shot="${fallback.id}"]{display:block}${mediaCss}`;
---

{
  shots.map((shot) => (
    <svg
      class="demo-route"
      data-map-shot={shot.id}
      viewBox={shot.viewBox}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {/* The whole loop, faint: the plan. Same blue, width and joins as the
          live map's `lineUpcoming` layer. */}
      <polyline
        points={shot.loop}
        fill="none"
        stroke={ROUTE_LINE.color}
        stroke-width={ROUTE_LINE.width}
        stroke-opacity={ROUTE_LINE.upcomingOpacity}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {/* The run so far, solid — the end frame's, shown only under reduced
          motion (see the style block). */}
      <polyline
        class="demo-route__run"
        points={shot.run}
        fill="none"
        stroke={ROUTE_LINE.color}
        stroke-width={ROUTE_LINE.width}
        stroke-opacity={ROUTE_LINE.opacity}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {/* The runner: MapView's runner layer, a 14px disc with a 2.5px white
          ring. An SVG stroke straddles the edge, so the radius is pulled in
          by half the ring to land on the same outline. Before the stops, as
          the live map draws it under them: at the start it sits beneath the
          first stop, and in the end frame — swapped in under reduced motion —
          beneath the stop the run ends on. */}
      <circle
        class="demo-route__runner demo-route__runner--start"
        cx={shot.runnerStart.x}
        cy={shot.runnerStart.y}
        r="5.75"
        style={`--route-line-color:${ROUTE_LINE.color}`}
      />
      <circle
        class="demo-route__runner demo-route__runner--end"
        cx={shot.runnerEnd.x}
        cy={shot.runnerEnd.y}
        r="5.75"
        style={`--route-line-color:${ROUTE_LINE.color}`}
      />
      {shot.stops.map((stop) => (
        <g>
          {/* `markerRadius` 9 with a 2px white ring — `MapView`'s defaults, which
              the hero map does not override. The fill is the opening colour;
              `--end` is what the reduced-motion end frame swaps in. */}
          <circle
            cx={stop.x}
            cy={stop.y}
            r="9"
            class="demo-route__stop"
            style={`--start:${stop.color};--end:${stop.endColor}`}
            stroke="#fff"
            stroke-width="2"
          />
          <text x={stop.x} y={stop.y} class="demo-route__label">
            {stop.label}
          </text>
        </g>
      ))}
      {/* The start flag: the same phosphor glyph the live map plants, drawn
          here at build time. Last, so it is over the runner that starts
          beneath it, as the live map's DOM marker is over the canvas. */}
      <g class="demo-route__flag" transform={`translate(${shot.flag.x} ${shot.flag.y})`}>
        <StartFlagIcon />
      </g>
    </svg>
  ))
}

<style>
  .demo-route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .demo-route__stop {
    fill: var(--start);
  }

  .demo-route__label {
    fill: #fff;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* Haloed in white like the stops' rings — MapView's `.start-flag`. */
  .demo-route__flag {
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff)
      drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35));
  }

  .demo-route__runner {
    fill: var(--route-line-color);
    stroke: #fff;
    stroke-width: 2.5;
  }

  /* The replay's end frame, for a visitor who will not see the replay. */
  .demo-route__run,
  .demo-route__runner--end {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-route__run,
    .demo-route__runner--end {
      display: initial;
    }
    .demo-route__runner--start {
      display: none;
    }
    .demo-route__stop {
      fill: var(--end);
    }
  }
</style>

<style is:inline set:html={css}></style>
