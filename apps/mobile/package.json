{
  "name": "@water-run/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev-server": "expo start --dev-client",
    "android:simulator:dev-server": "expo run:android",
    "ios:simulator:dev-server": "expo run:ios",
    "ios:device:dev-server": "expo run:ios --device",
    "ios:device:release-build": "expo run:ios --device --configuration Release --no-bundler",
    "ios:preview-build:local": "eas build --profile preview --platform ios --local",
    "ios:prod-build:testflight": "eas build --profile production --platform ios --local --output ./build/water-run.ipa",
    "ios:prod-build:xcode": "./scripts/build-ipa.sh",
    "ios:testflight:submit": "./scripts/submit-testflight.sh",
    "uniwind:types": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "pnpm uniwind:types && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@water-run/core": "workspace:*",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "^57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "phosphor-react-native": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.2",
    "expo-mcp": "~0.2.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3"
  }
}
