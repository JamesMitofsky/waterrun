# Copy to .env.local — Metro auto-loads EXPO_PUBLIC_* on `pnpm start`.

# Dev-only override for the Water Run backend. When __DEV__ is true (Metro/Expo Go),
# the app routes /api/* here instead of https://waterrun.app, so OAuth + writes hit
# a locally-run apps/site pointed at the OSM sandbox (api06.dev.openstreetmap.org)
# instead of production. Prod builds ignore this.
#
# iOS simulator: http://localhost:4321
# Physical device on LAN: http://<your-machine-lan-ip>:4321 (e.g. http://192.168.1.10:4321)
EXPO_PUBLIC_DEV_API_BASE=http://localhost:4321
