# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# turborepo
.turbo/

# production
build/

# misc
.DS_Store
*.pem

# local JSON pseudo-DB (caches, run state, edit log)
data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Output of the retired Next.js app and Storybook. Nothing here generates these
# any more; they stay ignored so an old checkout's leftovers can't be committed.
.next/
out/
next-env.d.ts
storybook-static/

# Claude Code worktrees live inside the repo; never commit them
.claude/worktrees/
